PORT=3000
NODE_ENV=development
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/spider-sense?retryWrites=true&w=majority
JWT_SECRET=your-jwt-secret-here
JWT_ACCESS_EXPIRE=7d
OTP_HASH_SECRET=your-otp-hash-secret-here
ADMIN_EMAILS=hero1@spidersense.nyc,spiderman@nyc.gov
HERO_EMAILS=hero1@spidersense.nyc,spiderman@nyc.gov

# Email Delivery - Resend API
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=Spider-Sense Dispatch <onboarding@resend.dev>

# Email Delivery - Gmail SMTP Fallback
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-gmail-app-password
